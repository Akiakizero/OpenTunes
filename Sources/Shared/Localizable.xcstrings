    "Aggiunge o toglie il love su Last.fm (o il preferito in Musica)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loves or unloves the track on Last.fm (or favorites it in Music)."
